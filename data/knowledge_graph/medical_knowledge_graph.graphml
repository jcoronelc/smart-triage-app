    <node id="Fungal infection">
      <data key="d0">Disease</data>
      <data key="d1">Fungal infection is a common skin condition caused by fungi.</data>
    </node>
    <node id="Allergy">
      <data key="d0">Disease</data>
      <data key="d1">Allergy is an immune system reaction to a substance in the environment.</data>
    </node>
    <node id="GERD">
      <data key="d0">Disease</data>
      <data key="d1">GERD (Gastroesophageal Reflux Disease) is a digestive disorder that affects the lower esophageal sphincter.</data>
    </node>
    <node id="Chronic cholestasis">
      <data key="d0">Disease</data>
      <data key="d1">Chronic cholestasis is a condition where bile flow from the liver is reduced for a prolonged period.</data>
    </node>
    <node id="Drug Reaction">
      <data key="d0">Disease</data>
      <data key="d1">Drug Reaction occurs when the body reacts adversely to a medication.</data>
    </node>
    <node id="Peptic ulcer disease">
      <data key="d0">Disease</data>
      <data key="d1">Peptic ulcer disease involves sores that develop on the inner lining of the stomach and small intestine.</data>
    </node>
    <node id="AIDS">
      <data key="d0">Disease</data>
      <data key="d1">AIDS (Acquired Immunodeficiency Syndrome) is a disease caused by HIV that weakens the immune system.</data>
    </node>
    <node id="Diabetes">
      <data key="d0">Disease</data>
      <data key="d1">Diabetes is a chronic condition that affects how the body processes blood sugar.</data>
    </node>
    <node id="Gastroenteritis">
      <data key="d0">Disease</data>
      <data key="d1">Gastroenteritis is an inflammation of the stomach and intestines, typically caused by a virus or bacteria.</data>
    </node>
    <node id="Bronchial Asthma">
      <data key="d0">Disease</data>
      <data key="d1">Bronchial Asthma is a respiratory condition characterized by inflammation of the airways.</data>
    </node>
    <node id="Hypertension">
      <data key="d0">Disease</data>
      <data key="d1">Hypertension, or high blood pressure, is a common cardiovascular condition.</data>
    </node>
    <node id="Migraine">
      <data key="d0">Disease</data>
      <data key="d1">Migraine is a type of headache that often involves severe pain and sensitivity to light and sound.</data>
    </node>
    <node id="Cervical spondylosis">
      <data key="d0">Disease</data>
      <data key="d1">Cervical spondylosis is a degenerative condition of the cervical spine.</data>
    </node>
    <node id="Paralysis (brain hemorrhage)">
      <data key="d0">Disease</data>
      <data key="d1">Paralysis (brain hemorrhage) refers to the loss of muscle function due to bleeding in the brain.</data>
    </node>
    <node id="Jaundice">
      <data key="d0">Disease</data>
      <data key="d1">Jaundice is a yellow discoloration of the skin and eyes, often indicating liver problems.</data>
    </node>
    <node id="Malaria">
      <data key="d0">Disease</data>
      <data key="d1">Malaria is a mosquito-borne infectious disease affecting humans and other animals.</data>
    </node>
    <node id="Chicken pox">
      <data key="d0">Disease</data>
      <data key="d1">Chicken pox is a highly contagious viral infection causing an itchy rash.</data>
    </node>
    <node id="Dengue">
      <data key="d0">Disease</data>
      <data key="d1">Dengue is a mosquito-borne viral infection causing flu-like symptoms.</data>
    </node>
    <node id="Typhoid">
      <data key="d0">Disease</data>
      <data key="d1">Typhoid is a bacterial infection that can lead to a high fever and gastrointestinal symptoms.</data>
    </node>
    <node id="hepatitis A">
      <data key="d0">Disease</data>
      <data key="d1">hepatitis A is a viral liver disease.</data>
    </node>
    <node id="Hepatitis B">
      <data key="d0">Disease</data>
      <data key="d1">Hepatitis B is a viral infection that attacks the liver.</data>
    </node>
    <node id="Hepatitis C">
      <data key="d0">Disease</data>
      <data key="d1">Hepatitis C is a viral infection that causes liver inflammation.</data>
    </node>
    <node id="Hepatitis D">
      <data key="d0">Disease</data>
      <data key="d1">Hepatitis D is a serious liver disease caused by the hepatitis D virus.</data>
    </node>
    <node id="Hepatitis E">
      <data key="d0">Disease</data>
      <data key="d1">Hepatitis E is a viral infection that causes liver inflammation.</data>
    </node>
    <node id="Alcoholic hepatitis">
      <data key="d0">Disease</data>
      <data key="d1">Alcoholic hepatitis is inflammation of the liver due to alcohol consumption.</data>
    </node>
    <node id="Tuberculosis">
      <data key="d0">Disease</data>
      <data key="d1">Tuberculosis is a bacterial infection that primarily affects the lungs.</data>
    </node>
    <node id="Common Cold">
      <data key="d0">Disease</data>
      <data key="d1">Common Cold is a viral infection of the upper respiratory tract.</data>
    </node>
    <node id="Pneumonia">
      <data key="d0">Disease</data>
      <data key="d1">Pneumonia is an inflammatory condition affecting the air sacs in the lungs.</data>
    </node>
    <node id="Dimorphic hemmorhoids(piles)">
      <data key="d0">Disease</data>
      <data key="d1">Dimorphic hemmorhoids(piles) is a condition characterized by swollen blood vessels in the rectum.</data>
    </node>
    <node id="Heart attack">
      <data key="d0">Disease</data>
      <data key="d1">Heart attack is a sudden and severe reduction in blood flow to the heart muscle.</data>
    </node>
    <node id="Varicose veins">
      <data key="d0">Disease</data>
      <data key="d1">Varicose veins are enlarged, twisted veins that usually appear on the legs.</data>
    </node>
    <node id="Hypothyroidism">
      <data key="d0">Disease</data>
      <data key="d1">Hypothyroidism is a condition where the thyroid gland doesn't produce enough thyroid hormone.</data>
    </node>
    <node id="Hyperthyroidism">
      <data key="d0">Disease</data>
      <data key="d1">Hyperthyroidism is a condition where the thyroid gland produces too much thyroid hormone.</data>
    </node>
    <node id="Hypoglycemia">
      <data key="d0">Disease</data>
      <data key="d1">Hypoglycemia is a condition characterized by abnormally low blood sugar levels.</data>
    </node>
    <node id="Osteoarthristis">
      <data key="d0">Disease</data>
      <data key="d1">Osteoarthristis is a degenerative joint disease that affects the cartilage in joints.</data>
    </node>
    <node id="Arthritis">
      <data key="d0">Disease</data>
      <data key="d1">Arthritis is inflammation of one or more joints, causing pain and stiffness.</data>
    </node>
    <node id="(vertigo) Paroymsal Positional Vertigo">
      <data key="d0">Disease</data>
      <data key="d1">(Vertigo) Paroxysmal Positional Vertigo is a type of dizziness caused by specific head movements.</data>
    </node>
    <node id="Acne">
      <data key="d0">Disease</data>
      <data key="d1">Acne is a skin condition that occurs when hair follicles become clogged with oil and dead skin cells.</data>
    </node>
    <node id="Urinary tract infection">
      <data key="d0">Disease</data>
      <data key="d1">Urinary tract infection is an infection in any part of the urinary system.</data>
    </node>
    <node id="Psoriasis">
      <data key="d0">Disease</data>
      <data key="d1">Psoriasis is a chronic skin condition characterized by red, itchy, and scaly patches.</data>
    </node>
    <node id="Impetigo">
